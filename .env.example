# Copy to .env locally. Never commit or paste real credentials into chat.
# ASR credentials: enable the recording-file model service in your console.
# The optional short-audio V2.0 backend requires its own service permission.
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=

# Hyper-realistic TTS uses its own app and APIPassword.
XFYUN_TTS_APP_ID=
XFYUN_TTS_API_PASSWORD=
